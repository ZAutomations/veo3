{
  "name": "veo3-flow-automation",
  "version": "1.0.0",
  "description": "Automates multi-scene video generation on Google Flow's Scenes UI via Puppeteer + CDP",
  "private": true,
  "main": "veo3_flow_new_ui.js",
  "scripts": {
    "start": "node veo3_flow_new_ui.js",
    "gui": "python veo3_gui.py",
    "agent": "node agent_mode.js",
    "agent:prompt": "node story_to_agent_prompt.js",
    "agent:download": "node agent_download.js",
    "agent:join": "node join_clips.js",
    "agent:order": "node order_clips_by_dialogue.js",
    "extend:prompts": "node extend_prompts.js",
    "agent:sheet": "node agent_download.js --sheet-only",
    "styles": "node styles.js",
    "story": "node write_story.js",
    "story:models": "node write_story.js --list-models",
    "mcp": "node mcp_server.js",
    "project": "node project_setup.js",
    "analyze": "node analyze_video.js",
    "xlsx": "python story_to_excel.py",
    "refs": "node generate_refs.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer": "^24.35.0"
  }
}
