# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc

# ── Local state (contains your Flow project URLs) ───────────────────────────
gui_settings.json
# Same privacy rule: the credit pool's account list (emails).
accounts.json

# ── Generated media & per-run artifacts ─────────────────────────────────────
*.mp4
*.zip
*.webm
stories/**/output/
stories/**/logs/
stories/**/clips/
logs/

# ── Story data ──────────────────────────────────────────────────────────────
# A story folder holds your own writing, your reference sheets and your rendered
# clips. None of it belongs in a public repo - and a reference sheet can be a
# photo of a real person, which is not a thing to publish by accident.
#
# The one exception is the example story, which the README documents the file
# format with. It stays tracked by force rather than by a negation rule here:
# git will not re-include a file whose parent directory is excluded, and ignore
# rules never apply to a file git already tracks anyway.
stories/
house_refs/

# ── Old-UI tool copies kept locally for reference ───────────────────────────
reference/

# ── Portable copy for moving to another PC ──────────────────────────────────
# A full copy of this folder - code, settings, stories and rendered media -
# built to be carried to another machine and set up there with SETUP.bat.
# Never part of the repo: it would duplicate every tracked file and drag
# hundreds of megabytes of generated media along with it.
Veo3_Portable/

# ── OS / editor noise ───────────────────────────────────────────────────────
# Stray placeholder left over from before these story folders had content.
stories/**/.gitkeep
Thumbs.db
desktop.ini
.vscode/
.idea/
*.log
